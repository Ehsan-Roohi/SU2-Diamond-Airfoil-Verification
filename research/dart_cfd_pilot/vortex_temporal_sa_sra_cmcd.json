{
  "schema_version": 1,
  "method_name": "Temporal Scale-Adaptive Shock-Ridge-Aware Coherent-Motion Core Detection (TSA-SRA-CMCD)",
  "short_name": "TSA-SRA-CMCD",
  "development_role": "derived from the frozen SA-SRA-CMCD Re=150 false-negative audit without using Gamma2 inside the detector",
  "base_spatial_configuration": "vortex_scale_adaptive_sra_cmcd.json",
  "minimum_spatial_physics_support": 2,
  "minimum_winding_ring_support": 2,
  "minimum_pressure_ring_support": 2,
  "minimum_temporal_support": 2,
  "lookaround_frames": 2,
  "maximum_convection_speed_over_u_infinity": 1.05,
  "maximum_upstream_backtracking_over_d": 0.25,
  "minimum_wall_distance_over_d": 0.75,
  "same_frame_suppression_radius_over_d": 0.35,
  "eligible_spatial_rejection_reasons": [
    "open_or_elongated_q_island",
    "insufficient_multiradius_winding",
    "pressure_minimum_not_corroborated"
  ],
  "recovered_candidates_may_support_other_recoveries": false,
  "gamma2_used_by_detector": false,
  "future_case_recalibration_allowed": false,
  "threshold_provenance": {
    "development_case": "d2q9_lbm_cylinder_re150_temporal_development",
    "independent_holdout": "d2q9_lbm_cylinder_re200_temporal_holdout",
    "selection_rule": "two of three spatial physics supports plus two original accepted same-sign temporal supports",
    "future_holdout_recalibration_allowed": false
  }
}
